#!/usr/bin/env bash
# Monthly external exposure scan.
# Runs nmap, testssl.sh, ssh-audit and nuclei against the targets of external-scan.conf
# and writes a plain text report per target. See README.md.
set -uo pipefail
export LC_ALL=C PYTHONDONTWRITEBYTECODE=1

BASE=$(dirname "$(readlink -f "$0")")
CONFIG=$BASE/external-scan.conf
OUTPUT=$BASE/results
PARSE=$BASE/parse.py
TESTSSL=$BASE/tools/testssl.sh/testssl.sh
SSH_AUDIT=$BASE/tools/ssh-audit/ssh-audit.py
NUCLEI=$BASE/tools/nuclei/nuclei
TYPST=$BASE/tools/typst/typst
TEMPLATE=$BASE/report.typ
# nuclei keeps its config and templates under $HOME, the scan user can only write here.
NUCLEI_HOME=$BASE/cache/nuclei
# One folder per run, so a second scan on the same day keeps the first one.
# A single date call, so a run started at midnight never mixes two days.
RUN_ID=$(date +%F_%H%M)
TODAY=${RUN_ID%_*}

CERT_WARN_DAYS=30
KEEP_MONTHS=12
# A full UDP scan takes about 18 hours because Linux rate limits ICMP replies, so only these.
UDP_PORTS=7,17,19,53,67,69,88,111,123,137,138,161,162,389,427,443,464,500,514,520,623,853,1194,1434,1701,1719,1812,1813,1900,2049,2427,3283,3389,3478,3702,4500,4569,5060,5160,5349,5351,5353,5683,10001,11211,37810,47808,51820,55820
UDP_PORTS_EXTRA=
# Remote access, admin web interfaces, databases and file sharing: risky when open to the Internet.
SENSITIVE_PORTS=21,23,135,139,445,902,1433,2082,2083,2086,2087,2222,2375,2376,2379,2380,3306,3389,4848,5000,5001,5432,5601,5900,5901,5985,5986,6379,6443,7001,8006,8007,8161,8291,8443,8728,8729,8834,8880,9000,9090,9200,9443,9990,10000,10250,11211,15672,19999,20000,27017
WEB_SCAN=off
PDF_REPORT=off
OPERATOR=
TARGET_IPS=()
TARGET_LABELS=()
declare -A TARGET_WEB_SCAN=()
declare -A TARGET_AUTH=()
NUCLEI_READY=0
NUCLEI_NOTE=
NUCLEI_TEMPLATES=
VERSIONS=()
CHECKS=()
ACCEPTS=()
LOG=
RUN_DIR=
NMAP_ARGS=()
SCAN_TYPE=
HAS_NET_RAW=0
SUMMARY=()
ANY_ERROR=0
ANY_ATTENTION=0

usage() {
    cat <<EOF
Usage: external-scan [--config FILE] [--output DIR]

  --config FILE  configuration file (default: $CONFIG)
  --output DIR   results directory (default: $OUTPUT)
EOF
}

log() {
    local line
    line="$(date '+%F %T') $*"
    if [[ -n $LOG ]]; then echo "$line" >>"$LOG"; else echo "$line" >&2; fi
}

die() {
    log "ERROR: $*"
    [[ -z $LOG ]] || echo "external-scan: $*" >&2
    exit 1
}

valid_port() {
    [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (( $1 <= 65535 ))
}

valid_date() {
    [[ $1 =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && $(date -d "$1" +%F 2>/dev/null) == "$1" ]]
}

# Reads "udp_ports" or "sensitive_ports": a comma separated list, or "none".
port_list() {
    local n=$1 value=$2 p
    [[ $value == none ]] && return
    for p in ${value//,/ }; do
        valid_port "$p" || die "line $n: invalid port '$p'"
    done
    echo "$value"
}

is_target() {
    local known
    for known in "${TARGET_IPS[@]}"; do
        [[ $known == "$1" ]] && return 0
    done
    return 1
}

# A "#" starts a comment, except inside double quotes, so an accept reason can hold one.
strip_comment() {
    local line=$1 out="" c i quoted=0
    for (( i = 0; i < ${#line}; i++ )); do
        c=${line:i:1}
        [[ $c == '"' ]] && quoted=$(( !quoted ))
        [[ $c == '#' ]] && (( !quoted )) && break
        out+=$c
    done
    printf '%s' "$out"
}

parse_config() {
    local line n=0 current="" ip label reason list
    local -a f
    [[ -r $CONFIG ]] || die "cannot read $CONFIG"
    while IFS= read -r line || [[ -n $line ]]; do
        n=$((n + 1))
        line=$(strip_comment "$line")
        [[ $line =~ ^[[:space:]]*$ ]] && continue
        read -r -a f <<<"$line"

        if [[ $line =~ ^[[:space:]] ]]; then
            [[ -n $current ]] || die "line $n: indented line outside a target block"
            if [[ ${f[0]} == accept ]]; then
                [[ ${#f[@]} -ge 5 && ${f[2]} == until ]] \
                    || die "line $n: expected 'accept <key pattern> until <YYYY-MM-DD> <reason>'"
                [[ ${f[1]} =~ ^[A-Za-z0-9._:@*?/-]+$ ]] || die "line $n: invalid key pattern '${f[1]}'"
                valid_date "${f[3]}" || die "line $n: invalid date '${f[3]}', use YYYY-MM-DD"
                reason="${f[*]:4}"
                reason=${reason#\"}
                ACCEPTS+=("$current"$'\t'"${f[1]}"$'\t'"${f[3]}"$'\t'"${reason%\"}")
                continue
            fi
            if [[ ${f[0]} == authorization ]]; then
                (( ${#f[@]} >= 2 )) || die "line $n: authorization needs a text"
                [[ -z ${TARGET_AUTH[$current]:-} ]] || die "line $n: second authorization line for $current"
                reason="${f[*]:1}"
                reason=${reason#\"}
                TARGET_AUTH[$current]=${reason%\"}
                continue
            fi
            if [[ ${f[0]} == web_scan ]]; then
                [[ ${#f[@]} -eq 2 && ${f[1]} =~ ^(on|off)$ ]] || die "line $n: web_scan needs 'on' or 'off'"
                [[ -z ${TARGET_WEB_SCAN[$current]:-} ]] || die "line $n: second web_scan line for $current"
                TARGET_WEB_SCAN[$current]=${f[1]}
                continue
            fi
            (( ${#f[@]} == 3 )) || die "line $n: expected '<mode> <fqdn> <port>', 'accept ...', 'authorization ...' or 'web_scan on|off'"
            [[ ${f[0]} =~ ^(https|tls|(smtp|imap|pop3)s?)$ ]] || die "line $n: unknown mode '${f[0]}'"
            [[ ${f[1]} =~ ^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$ ]] || die "line $n: invalid name '${f[1]}'"
            valid_port "${f[2]}" || die "line $n: invalid port '${f[2]}'"
            CHECKS+=("$current ${f[0]} ${f[1]} ${f[2]}")
            continue
        fi

        current=""
        case ${f[0]} in
            target)
                (( ${#f[@]} >= 2 )) || die "line $n: expected 'target <ip> [label]'"
                ip=$(python3 "$PARSE" check-ip "${f[1]}" 2>/dev/null) \
                    || die "line $n: '${f[1]}' is not a single IP address (no range, no host name)"
                is_target "$ip" && die "line $n: $ip is listed twice"
                label="${f[*]:2}"
                TARGET_IPS+=("$ip")
                TARGET_LABELS+=("${label:-$ip}")
                current=$ip
                ;;
            cert_warn_days)
                [[ ${#f[@]} -eq 2 && ${f[1]} =~ ^(0|[1-9][0-9]*)$ ]] || die "line $n: cert_warn_days needs a number"
                CERT_WARN_DAYS=${f[1]}
                ;;
            keep_months)
                [[ ${#f[@]} -eq 2 && ${f[1]} =~ ^[1-9][0-9]*$ ]] || die "line $n: keep_months needs a number of at least 1"
                KEEP_MONTHS=${f[1]}
                ;;
            udp_ports | sensitive_ports)
                [[ ${#f[@]} -eq 2 ]] || die "line $n: ${f[0]} needs a comma separated list or 'none'"
                list=$(port_list "$n" "${f[1]}") || exit 1
                if [[ ${f[0]} == udp_ports ]]; then UDP_PORTS=$list; else SENSITIVE_PORTS=$list; fi
                ;;
            udp_ports_extra)
                [[ ${#f[@]} -eq 2 && ${f[1]} != none ]] || die "line $n: udp_ports_extra needs a comma separated list"
                list=$(port_list "$n" "${f[1]}") || exit 1
                UDP_PORTS_EXTRA+=${UDP_PORTS_EXTRA:+,}$list
                ;;
            web_scan)
                [[ ${#f[@]} -eq 2 && ${f[1]} =~ ^(on|off)$ ]] || die "line $n: web_scan needs 'on' or 'off'"
                WEB_SCAN=${f[1]}
                ;;
            pdf_report)
                [[ ${#f[@]} -eq 2 && ${f[1]} =~ ^(on|off)$ ]] || die "line $n: pdf_report needs 'on' or 'off'"
                PDF_REPORT=${f[1]}
                ;;
            operator)
                (( ${#f[@]} >= 2 )) || die "line $n: operator needs a name"
                OPERATOR="${f[*]:1}"
                OPERATOR=${OPERATOR#\"}
                OPERATOR=${OPERATOR%\"}
                ;;
            *)
                die "line $n: unknown keyword '${f[0]}'"
                ;;
        esac
    done <"$CONFIG"
    (( ${#TARGET_IPS[@]} > 0 )) || die "no target in $CONFIG, nothing to scan"
    # Added to the list instead of replacing it, so a site can scan one more port without copying the defaults.
    [[ -z $UDP_PORTS_EXTRA ]] \
        || UDP_PORTS=$(tr ',' '\n' <<<"${UDP_PORTS:+$UDP_PORTS,}$UDP_PORTS_EXTRA" | sort -nu | paste -sd,)
}

check_tools() {
    local tool
    for tool in nmap ssh python3 timeout flock awk comm; do
        command -v "$tool" >/dev/null || die "missing command: $tool"
    done
    [[ -x $TESTSSL ]] || die "testssl.sh not found at $TESTSSL, run install.sh"
    [[ -f $SSH_AUDIT ]] || die "ssh-audit not found at $SSH_AUDIT, run install.sh"
    if any_web_scan; then
        [[ -x $NUCLEI ]] || die "nuclei not found at $NUCLEI, run install.sh"
    fi
    if [[ $PDF_REPORT != off ]]; then
        [[ -x $TYPST ]] || die "typst not found at $TYPST, run install.sh"
        [[ -r $TEMPLATE ]] || die "cannot read $TEMPLATE"
    fi
}

# Tool versions for the "how" part of the PDF report.
tool_versions() {
    VERSIONS+=("external-scan"$'\t'"$(git -c safe.directory="$BASE" -C "$BASE" describe --tags --always --dirty 2>/dev/null)")
    VERSIONS+=("nmap"$'\t'"$(nmap --version 2>/dev/null | awk 'NR == 1 {print $3}')")
    VERSIONS+=("testssl.sh"$'\t'"$(sed -n 's/^declare -r VERSION="\(.*\)"$/\1/p' "$TESTSSL" | head -1)")
    VERSIONS+=("ssh-audit"$'\t'"$(sed -n "s/^VERSION = '\(.*\)'$/\1/p" "${SSH_AUDIT%/*}/src/ssh_audit/globals.py")")
    VERSIONS+=("typst"$'\t'"$("$TYPST" --version 2>/dev/null | awk '{print $2}')")
}

web_scan_on() {
    [[ ${TARGET_WEB_SCAN[$1]:-$WEB_SCAN} == on ]]
}

any_web_scan() {
    local c cip mode
    for c in "${CHECKS[@]}"; do
        read -r cip mode _ <<<"$c"
        [[ $mode == https ]] && web_scan_on "$cip" && return 0
    done
    return 1
}

# Templates are updated once per run, before the first web scan.
update_nuclei_templates() {
    NUCLEI_READY=1
    mkdir -p "$NUCLEI_HOME" 2>>"$LOG"
    log "nuclei templates update"
    # Without -duc on purpose: with it, nuclei skips the template download.
    # Without templates at all, run_nuclei reports failed/web instead.
    if ! HOME=$NUCLEI_HOME timeout 15m "$NUCLEI" -ut -nc </dev/null >/dev/null 2>>"$LOG" \
        && [[ -d $NUCLEI_HOME/nuclei-templates/http ]]; then
        NUCLEI_NOTE="The nuclei templates update failed, the web scan used the templates of a previous run. See scan.log."
    fi
    NUCLEI_TEMPLATES=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["nuclei-templates-version"])' \
        "$NUCLEI_HOME/.config/nuclei/.templates-config.json" 2>/dev/null)
}

has_net_raw() {
    local caps
    caps=$(awk '/^CapEff:/ {print $2}' "/proc/$$/status")
    (( (16#$caps >> 13) & 1 ))
}

host_port() {
    if [[ $1 == *:* ]]; then echo "[$1]:$2"; else echo "$1:$2"; fi
}

# Prints one formatted line for a port, reading the parse.py ports output on stdin.
port_line() {
    awk -F'\t' -v p="$1" '$1 == p { printf "%-10s %-14s %s\n", $1, $2, ($4 == "-" ? "" : $4) }'
}

port_is_open() {
    awk -F'\t' -v p="$1/tcp" '$1 == p { found = 1 } END { exit !found }' "$2"
}

# Also matches the folders named after the day only, written before the time was added.
is_run_dir() {
    [[ -d $1 && ! -L $1 && ${1##*/} =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}(_[0-9]{4})?$ ]]
}

# "2026-11-01_0312" -> "2026-11-01 03:12", "2026-11-01" stays as is.
run_time() {
    local id=$1
    [[ $id == *_* ]] && id="${id%_*} ${id:11:2}:${id:13:2}"
    echo "$id"
}

find_previous() {
    local ip=$1 i day xml
    local -a days=("$OUTPUT"/[0-9]*)
    for (( i = ${#days[@]} - 1; i >= 0; i-- )); do
        day=${days[i]}
        is_run_dir "$day" && [[ ${day##*/} != "$RUN_ID" ]] || continue
        for xml in "$day/${ip}"_*/nmap.xml; do
            if [[ -f $xml ]] && python3 "$PARSE" ports "$xml" >/dev/null 2>&1; then
                echo "$xml"
                return
            fi
        done
    done
}

# The functions below run inside scan_target and use its local variables.

flag() {
    [[ $status == ERROR ]] || status=ATTENTION
}

# A finding has a stable key, so it can be accepted and compared with the previous scan.
add_finding() {
    findings+=("$1"$'\t'"$2")
}

check_dns() {
    local fqdn=$1 addrs
    [[ $dns_done == *" $fqdn "* ]] && return
    dns_done+="$fqdn "
    tested+=" dns/$fqdn "
    if ! addrs=$(python3 "$PARSE" resolve "$fqdn" 2>>"$LOG"); then
        add_finding "dns/$fqdn" "$fqdn does not resolve in DNS. It was tested on $ip anyway."
    elif [[ " $addrs " != *" $ip "* ]]; then
        add_finding "dns/$fqdn" "$fqdn resolves to $addrs, not to $ip. It was tested on $ip anyway."
    fi
}

run_testssl() {
    local mode=$1 fqdn=$2 port=$3 host=${2:-$ip} name shown target parsed rc kind a b c line
    local -a args=(--quiet --color 0 --warnings batch --overwrite --connect-timeout 10 --openssl-timeout 10)
    if [[ -n $fqdn ]]; then
        name=${fqdn}_$port
        shown=$fqdn:$port
        target=$fqdn:$port
        # Always connect to the authorized IP, whatever the DNS says for this name.
        args+=(--ip "$ip")
    else
        name=ip_$port
        shown=$(host_port "$ip" "$port")
        target=$shown
    fi
    case $mode in
        https) target=https://$target ;;
        smtp | imap | pop3) args+=(-t "$mode") ;;
        # TLS from the first byte: the name only says which service it is.
        tls | smtps | imaps | pop3s) ;;
        *) die "run_testssl: unknown mode '$mode'" ;;
    esac

    log "[$ip] testssl $shown ($mode)"
    timeout 30m "$TESTSSL" "${args[@]}" \
        --jsonfile "$dir/testssl/$name.json" --logfile "$dir/testssl/$name.log" \
        "$target" </dev/null >/dev/null 2>>"$LOG"
    rc=$?
    if ! parsed=$(python3 "$PARSE" testssl "$dir/testssl/$name.json" 2>>"$LOG"); then
        add_finding "failed/tls/$host/$port" "testssl gave no usable result on $shown (exit $rc). See testssl/$name.log."
        failures=1
        return
    fi
    # A FATAL line means testssl could not finish, so the findings it did not write are not fixed.
    if grep -q '^FATAL' <<<"$parsed"; then
        add_finding "failed/tls/$host/$port" "testssl could not finish on $shown: $(grep '^FATAL' <<<"$parsed" | head -1 | cut -f3)"
        failures=1
    else
        tested+=" tls/$host/$port cert/$host/$port "
    fi
    while IFS=$'\t' read -r kind a b c; do
        case $kind in
            CERT)
                line=$(printf '%-45s expires %s, %s days left' "$shown" "$a" "$b")
                if (( b < 0 )); then
                    line+="  EXPIRED"
                    add_finding "cert/$host/$port" "Certificate on $shown expired on $a."
                elif (( b < CERT_WARN_DAYS )); then
                    line+="  RENEW SOON"
                    add_finding "cert/$host/$port" "Certificate on $shown expires in $b days ($a)."
                fi
                certs+=("$line")
                ;;
            ISSUE)
                add_finding "tls/$host/$port/$b" "testssl $a on $shown: $c"
                ;;
        esac
    done <<<"$parsed"
}

run_ssh_audit() {
    local port=$1 out=$dir/ssh-audit_$1.json parsed kind a b c
    log "[$ip] ssh-audit port $port"
    # One connection only: sshd penalties, sshguard or CrowdSec cut or ban repeated unauthenticated connections.
    timeout 5m python3 "$SSH_AUDIT" -jj -p "$port" "$ip" </dev/null >"$out" 2>>"$LOG"
    if ! parsed=$(python3 "$PARSE" ssh-audit "$out" 2>>"$LOG"); then
        add_finding "failed/ssh/$port" "ssh-audit gave no usable result on port $port. See ssh-audit_$port.json and scan.log."
        failures=1
        return
    fi
    tested+=" ssh/$port "
    while IFS=$'\t' read -r kind a b c; do
        case $kind in
            FAIL) add_finding "ssh/$port/$a/$b" "ssh-audit on port $port, $a $b: $c" ;;
            CVE) add_finding "ssh/$port/cve/$a" "ssh-audit on port $port, $a (CVSS $b): $c" ;;
        esac
    done <<<"$parsed"
}

run_nuclei() {
    local fqdn=$1 port=$2 name=${1}_$2 shown=$1:$2 vhost=$1 parsed rc kind a b c
    (( NUCLEI_READY )) || update_nuclei_templates
    web_ran=1
    if [[ ! -d $NUCLEI_HOME/nuclei-templates/http ]]; then
        add_finding "failed/web/$fqdn/$port" "No nuclei templates in $NUCLEI_HOME, the web scan of $shown did not run. See scan.log."
        failures=1
        return
    fi
    [[ $port == 443 ]] || vhost=$shown
    mkdir -p "$dir/nuclei"
    log "[$ip] nuclei $shown"
    # Connect to the authorized IP and present the name in SNI and Host, like testssl --ip.
    # Redirects are not followed, so a redirect to another host is never scanned.
    # No interactsh: its callbacks go to third party servers.
    HOME=$NUCLEI_HOME timeout 30m "$NUCLEI" -duc -nc -ni -dr -jsonl -or -ot \
        -pt http -s critical,high -etags dos,intrusive,fuzz \
        -rl 20 -c 10 -timeout 10 \
        -H "Host: $vhost" -sni "$fqdn" -u "https://$(host_port "$ip" "$port")" \
        -o "$dir/nuclei/$name.jsonl" </dev/null >/dev/null 2>"$dir/nuclei/$name.log"
    rc=$?
    if (( rc != 0 )) || ! parsed=$(python3 "$PARSE" nuclei "$dir/nuclei/$name.jsonl" 2>>"$LOG"); then
        add_finding "failed/web/$fqdn/$port" "nuclei gave no usable result on $shown (exit $rc). See nuclei/$name.log."
        failures=1
        return
    fi
    # nuclei drops a host that stops answering and still exits 0, so its missing findings are not fixed.
    if grep -q 'found unresponsive' "$dir/nuclei/$name.log"; then
        add_finding "failed/web/$fqdn/$port" "nuclei stopped on $shown, the site stopped answering. See nuclei/$name.log."
        failures=1
    else
        tested+=" web/$fqdn/$port "
    fi
    while IFS=$'\t' read -r kind a b c; do
        [[ $kind == ISSUE ]] && add_finding "web/$fqdn/$port/$b" "nuclei $a on $shown: $c"
    done <<<"$parsed"
}

# Asks the server for its login methods with the "none" method, which tries no password or key.
# The OpenSSH client is used because the nmap of Rocky and RHEL is built without libssh2,
# so its ssh-auth-methods script never runs there.
check_ssh_auth() {
    local ports=$1 port out methods reason
    for port in ${ports//,/ }; do
        log "[$ip] ssh login methods on port $port"
        # -N runs nothing on the target. Old algorithms are allowed for this probe only, since
        # legacy servers are the ones most likely to accept passwords.
        out=$(timeout 25 ssh -v -N -F /dev/null -o BatchMode=yes -o PreferredAuthentications=none \
            -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o GlobalKnownHostsFile=/dev/null \
            -o ConnectTimeout=15 -o KexAlgorithms=+diffie-hellman-group14-sha1,diffie-hellman-group1-sha1 \
            -o HostKeyAlgorithms=+ssh-rsa -p "$port" "nobody@$ip" </dev/null 2>&1)
        if grep -q '^Authenticated to .* using "none"' <<<"$out"; then
            tested+=" sshpw/$port "
            add_finding "sshpw/$port" "SSH on port $port opened a session without any login. Require a key."
        elif [[ $out =~ Permission\ denied\ \(([^\)]+)\) ]]; then
            methods=${BASH_REMATCH[1]//,/ }
            tested+=" sshpw/$port "
            if [[ " $methods " == *" password "* || " $methods " == *" keyboard-interactive "* ]]; then
                add_finding "sshpw/$port" "SSH on port $port accepts password login ($methods). Prefer keys only."
            fi
        else
            # One line only: findings.tsv holds one finding per line.
            reason=$(grep -v '^debug' <<<"$out" | tail -1 | tr -d '\r' | tr '\t' ' ')
            add_finding "failed/sshpw/$port" "Could not list the SSH login methods on port $port: ${reason:-no answer}"
            failures=1
        fi
    done
}

check_sensitive_ports() {
    local p svc
    tested+=" sensitive "
    while IFS=$'\t' read -r p svc _ _; do
        [[ $p == */tcp && ,$SENSITIVE_PORTS, == *,${p%/tcp},* ]] || continue
        add_finding "sensitive/${p%/tcp}" "Port $p ($svc) is open to the Internet. Remote access and admin ports should be filtered by source IP or reached through a VPN."
    done <"$dir/ports.tsv"
}

# Splits the findings into accepted and needing attention, and spots expired or unused accept lines.
classify_findings() {
    local f key text a aip pattern until reason valid expired
    local -A used=() count=()
    for f in "${findings[@]}"; do
        key=${f%%$'\t'*}
        text=${f#*$'\t'}
        valid="" expired=""
        # A valid accept line wins over an expired one, whatever their order in the config.
        for a in "${ACCEPTS[@]}"; do
            IFS=$'\t' read -r aip pattern until reason <<<"$a"
            # shellcheck disable=SC2053 # The pattern is a glob on purpose.
            [[ $aip == "$ip" && $key == $pattern ]] || continue
            used[$pattern]=1
            if [[ $until < $TODAY ]]; then
                expired=${expired:-$until}
            else
                valid=$pattern
                break
            fi
        done
        if [[ -n $valid ]]; then
            count[$valid]=$(( ${count[$valid]:-0} + 1 ))
        elif [[ -n $expired ]]; then
            attention+=("$key"$'\t'"$text (accepted until $expired, the acceptance has expired)")
        else
            attention+=("$key"$'\t'"$text")
        fi
    done
    # One line per accept line keeps the report short. findings.tsv lists every finding.
    for a in "${ACCEPTS[@]}"; do
        IFS=$'\t' read -r aip pattern until reason <<<"$a"
        [[ $aip == "$ip" ]] || continue
        if [[ -n ${count[$pattern]:-} ]]; then
            accepted+=("$pattern (${count[$pattern]} finding(s)) until $until: $reason")
            accepted_data+=("$pattern"$'\t'"${count[$pattern]}"$'\t'"$until"$'\t'"$reason")
        elif [[ -z ${used[$pattern]:-} ]] && (( ! failures )); then
            # Skipped when a tool failed, because the finding may only be missing for that reason.
            notes+=("accept $pattern matched nothing in this scan. If the risk is gone, the line can be removed.")
        fi
    done
    (( ${#attention[@]} == 0 )) || flag
}

# A finding counts as fixed only if the check that produced it ran again, so a failed tool never looks like a fix.
compare_findings() {
    local prev_file=$1 key scope
    printf '%s\n' "${findings[@]}" | sed '/^$/d' >"$dir/findings.tsv"
    if [[ ! -f $prev_file ]]; then
        [[ -z $prev_date ]] || changes+=("No findings in the previous report, findings start their history today.")
        return
    fi
    while IFS= read -r key; do
        [[ -n $key ]] || continue
        changes+=("NEW finding    $key")
    done < <(comm -13 <(cut -f1 "$prev_file" | sort -u) <(cut -f1 "$dir/findings.tsv" | sort -u))
    while IFS= read -r key; do
        case $key in
            "" | failed/*) continue ;;
            sensitive/*) scope=sensitive ;;
            tls/* | cert/* | web/*) scope=$(cut -d/ -f1-3 <<<"$key") ;;
            *) scope=$(cut -d/ -f1-2 <<<"$key") ;;
        esac
        [[ $tested == *" $scope "* ]] && changes+=("FIXED finding  $key")
    done < <(comm -23 <(cut -f1 "$prev_file" | sort -u) <(cut -f1 "$dir/findings.tsv" | sort -u))
}

section() {
    local title=$1 intro=$2 item
    shift 2
    printf '\n== %s ==\n%s\n' "$title" "$intro"
    if (( $# == 0 )); then
        echo "  None."
    else
        for item in "$@"; do
            echo "  $item"
        done
    fi
}

write_report() {
    local -a open=() needs=() suggest=()
    local item next_year
    next_year=$(date -d '+1 year' +%F)
    [[ ! -s $dir/ports.tsv ]] || mapfile -t open < <(
        awk -F'\t' '{ printf "%-10s %-14s %s\n", $1, $2, ($4 == "-" ? "" : $4) }' "$dir/ports.tsv")
    for item in "${attention[@]}"; do
        needs+=("${item%%$'\t'*}" "    ${item#*$'\t'}")
        suggest+=("accept ${item%%$'\t'*} until $next_year \"why this risk is accepted\"")
    done
    {
        echo "External scan report"
        echo "Target : $ip ($label)"
        echo "Date   : $(run_time "$RUN_ID")"
        echo "Scan   : $SCAN_TYPE"
        echo "Status : $status"
        echo
        echo "OK means nothing needs a look. ATTENTION means read \"What changed\" and \"Needs attention\"."
        echo "ERROR means the scan did not complete and this report is partial."
        section "What changed${prev_date:+ since $prev_date}" \
            "Ports that appeared (NEW) or disappeared (GONE), and findings that are new or fixed since the previous scan." "${changes[@]}"
        section "Needs attention" \
            "Findings that are not accepted in the config. Each one starts with its key." "${needs[@]}"
        section "Accepted risks" \
            "Accept lines of the config, the number of findings each one covers and why. Findings come back in \"Needs attention\" after the date." "${accepted[@]}"
        (( ${#suggest[@]} == 0 )) || section "Suggested accept lines" \
            "To accept a known risk, copy its line under this target in external-scan.conf and write the real reason. A '*' in the key matches anything." "${suggest[@]}"
        section "Open ports" \
            "Ports that answer from the Internet, with the service nmap recognised. All TCP ports, UDP only for: ${UDP_PORTS:-none}." "${open[@]}"
        section "Certificates" \
            "Expiry date of each certificate seen. Alert below $CERT_WARN_DAYS days." "${certs[@]}"
        section "Known vulnerabilities by version (vulners)" \
            "CVEs matched on the version string only. Distro packages often fix them without changing the version, so check before acting. Not counted in the status. Details in nmap.txt." "${vulns[@]}"
        section "Notes" \
            "Skipped checks, tool errors and accept lines that match nothing." "${notes[@]}"
    } >"$dir/$report.txt"
    [[ $PDF_REPORT == off ]] || write_pdf
}

# Prints one "<kind>\t<value>" line per value, for parse.py report.
emit() {
    local kind=$1 value
    shift
    for value in "$@"; do
        printf '%s\t%s\n' "$kind" "$value"
    done
}

report_data() {
    emit ip "$ip"
    emit label "$label"
    emit pdf "$report.pdf"
    emit date "$(run_time "$RUN_ID")"
    emit started "$started"
    emit finished "$(date +%s)"
    emit status "$status"
    emit scan_type "$SCAN_TYPE"
    emit nmap_args "${NMAP_ARGS[*]}"
    emit udp_ports "$UDP_PORTS"
    emit udp_done "$udp_done"
    emit sensitive_ports "$SENSITIVE_PORTS"
    emit cert_warn_days "$CERT_WARN_DAYS"
    emit keep_months "$KEEP_MONTHS"
    emit nmap_done "$nmap_done"
    emit web_ran "$web_ran"
    emit operator "$OPERATOR"
    emit authorization "${TARGET_AUTH[$ip]:-}"
    emit scanner "$(hostname -f 2>/dev/null || uname -n)"
    emit source "$(ip -o route get "$ip" 2>/dev/null | grep -o 'src [^ ]*' | cut -d' ' -f2)"
    emit previous "$prev_date"
    emit new_ports "$new_count"
    emit version "${VERSIONS[@]}"
    if (( web_ran )); then
        emit version "nuclei"$'\t'"$(cat "${NUCLEI%/*}/VERSION" 2>/dev/null), templates ${NUCLEI_TEMPLATES:-unknown}"
    fi
    emit change "${changes[@]}"
    emit attention "${attention[@]}"
    emit accepted "${accepted_data[@]}"
    emit note "${notes[@]}"
    emit check "${checked[@]}"
}

# The PDF goes to the owner of the target. A failure shows in SUMMARY.txt but never changes the status.
# report.json is kept when only typst fails, so the PDF can be rendered again by hand.
write_pdf() {
    if ! report_data | python3 "$PARSE" report "$dir" >"$dir/report.json" 2>>"$LOG"; then
        rm -f "$dir/report.json"
    elif "$TYPST" compile --root / --ignore-system-fonts \
        --input data="$dir/report.json" \
        "$TEMPLATE" "$dir/$report.pdf" </dev/null >/dev/null 2>>"$LOG"; then
        return
    fi
    log "[$ip] PDF report failed"
    rm -f "$dir/$report.pdf"
    pdf_failed=1
}

scan_target() {
    local ip=$1 label=$2
    local safe=${label//[^A-Za-z0-9._-]/_}
    local dir=$RUN_DIR/${ip}_$safe
    # The name and date stay in the file name, so a report sent on its own is still told apart.
    # Only the first word of the label, the rest is a free description.
    local name=${label%% *}
    local report=REPORT_${name//[^A-Za-z0-9._-]/_}_$RUN_ID
    local status=OK prev="" prev_date="" prev_tsv="" prev_udp="" cur_ports="" covered=" " dns_done=" "
    local new_count=0 udp_done=0 failures=0 tested=" " ssh_ports="" web_ran=0 pdf_failed=0 nmap_done=0
    local started c cip mode fqdn port p svc tunnel high max total
    local -a family=() changes=() certs=() vulns=() notes=() findings=() attention=() accepted=() accepted_data=() checked=()

    started=$(date +%s)
    # Before nmap, so a report on a failed nmap still names the previous scan.
    prev=$(find_previous "$ip")
    [[ -z $prev ]] || prev_date=$(run_time "$(basename "$(dirname "$(dirname "$prev")")")")

    mkdir -p "$dir/testssl"
    # nmap refuses an IPv6 address without -6.
    [[ $ip != *:* ]] || family=(-6)
    log "[$ip] nmap started, $SCAN_TYPE, all TCP ports"
    timeout 6h nmap "${family[@]}" "${NMAP_ARGS[@]}" -oX "$dir/nmap.xml" -oN "$dir/nmap.txt" "$ip" </dev/null >/dev/null 2>>"$LOG"
    if ! python3 "$PARSE" ports "$dir/nmap.xml" >"$dir/ports.tsv" 2>>"$LOG"; then
        log "[$ip] nmap failed"
        status=ERROR
        notes+=("nmap did not finish, nothing else was tested. See scan.log.")
        [[ -z $prev_date ]] || changes+=("Not compared, nmap did not finish.")
        write_report
        record
        return
    fi
    nmap_done=1
    log "[$ip] nmap done, $(wc -l <"$dir/ports.tsv") open TCP port(s)"

    if [[ -z $UDP_PORTS ]]; then
        :
    elif (( ! HAS_NET_RAW )); then
        notes+=("UDP not scanned, it needs CAP_NET_RAW. Start the scan with systemctl.")
    else
        log "[$ip] nmap UDP started, ports $UDP_PORTS"
        timeout 4h nmap "${family[@]}" -Pn -sU -sV --script vulners -p "$UDP_PORTS" --open --privileged \
            -oX "$dir/nmap-udp.xml" -oN "$dir/nmap-udp.txt" "$ip" </dev/null >/dev/null 2>>"$LOG"
        if python3 "$PARSE" ports "$dir/nmap-udp.xml" >>"$dir/ports.tsv" 2>>"$LOG"; then
            udp_done=1
            log "[$ip] nmap UDP done"
        else
            add_finding "failed/udp" "The UDP scan did not finish, UDP ports are missing. See scan.log."
            failures=1
        fi
    fi

    if [[ -z $prev ]]; then
        changes+=("First scan of this target. This report is the baseline, there is nothing to compare.")
    else
        prev_tsv=$(python3 "$PARSE" ports "$prev")
        cur_ports=$(cut -f1 "$dir/ports.tsv")
        # UDP is compared only when both scans have it, so a missing UDP scan never looks like closed ports.
        if (( udp_done )); then
            if [[ -f ${prev%/nmap.xml}/nmap-udp.xml ]] \
                && prev_udp=$(python3 "$PARSE" ports "${prev%/nmap.xml}/nmap-udp.xml" 2>>"$LOG"); then
                prev_tsv+=$'\n'$prev_udp
            else
                cur_ports=$(grep -v '/udp$' <<<"$cur_ports")
                changes+=("No UDP scan in the previous report. UDP ports start their baseline today.")
            fi
        fi
        while IFS= read -r p; do
            [[ -n $p ]] || continue
            changes+=("NEW   $(port_line "$p" <"$dir/ports.tsv")")
            new_count=$((new_count + 1))
        done < <(comm -13 <(cut -f1 <<<"$prev_tsv" | sort) <(sort <<<"$cur_ports"))
        while IFS= read -r p; do
            [[ -n $p ]] || continue
            changes+=("GONE  $(port_line "$p" <<<"$prev_tsv")")
        done < <(comm -23 <(cut -f1 <<<"$prev_tsv" | sort) <(sort <<<"$cur_ports"))
        (( new_count )) && flag
        if command -v ndiff >/dev/null; then
            ndiff "$prev" "$dir/nmap.xml" >"$dir/ndiff.txt" 2>>"$LOG"
        fi
    fi

    while IFS=$'\t' read -r p high max total; do
        [[ -n $p ]] || continue
        vulns+=("$(printf '%-10s %s known CVEs, %s rated 7.0 or more, highest %s' "$p" "$total" "$high" "$max")")
    done < <(python3 "$PARSE" vulners "$dir/nmap.xml" 2>>"$LOG")

    for c in "${CHECKS[@]}"; do
        read -r cip mode fqdn port <<<"$c"
        [[ $cip == "$ip" ]] || continue
        if ! port_is_open "$port" "$dir/ports.tsv"; then
            notes+=("$fqdn:$port ($mode) skipped, port $port is not open.")
            continue
        fi
        check_dns "$fqdn"
        run_testssl "$mode" "$fqdn" "$port"
        covered+="$port "
        checked+=("$mode $fqdn $port")
        if [[ $mode == https ]] && web_scan_on "$ip"; then
            run_nuclei "$fqdn" "$port"
        fi
    done
    (( ! web_ran )) || [[ -z $NUCLEI_NOTE ]] || notes+=("$NUCLEI_NOTE")

    while IFS=$'\t' read -r p svc tunnel _; do
        [[ $p == */tcp ]] || continue
        port=${p%/*}
        if [[ $svc == ssh ]]; then
            run_ssh_audit "$port"
            ssh_ports+=${ssh_ports:+,}$port
        elif [[ $covered == *" $port "* ]]; then
            continue
        elif [[ $svc =~ ^(imaps|pop3s|smtps)$ ]]; then
            run_testssl "$svc" "" "$port"
        elif [[ $tunnel == ssl || $svc =~ ^(ssl|https|https-alt)$ ]]; then
            run_testssl tls "" "$port"
        elif [[ $svc =~ ^(smtp|imap|pop3)$ ]]; then
            run_testssl "$svc" "" "$port"
        fi
    done <"$dir/ports.tsv"

    [[ -z $ssh_ports ]] || check_ssh_auth "$ssh_ports"
    check_sensitive_ports
    compare_findings "${prev:+${prev%/nmap.xml}/findings.tsv}"
    [[ -z $prev_date || ${#changes[@]} -gt 0 ]] || changes+=("No change.")
    classify_findings

    write_report
    record
    log "[$ip] done, status $status"
}

record() {
    SUMMARY+=("$(printf '%-9s %-45s %s new port(s), %s to look at, %s accept line(s) used  %s/%s.txt%s' \
        "$status" "$ip ($label)" "$new_count" "${#attention[@]}" "${#accepted[@]}" "${dir##*/}" "$report" \
        "$( (( pdf_failed )) && echo "  PDF failed, see scan.log")")")
    case $status in
        ERROR) ANY_ERROR=1 ;;
        ATTENTION) ANY_ATTENTION=1 ;;
    esac
}

prune_old() {
    local cutoff day name
    cutoff=$(date -d "-$KEEP_MONTHS months" +%F)
    for day in "$OUTPUT"/[0-9]*; do
        name=${day##*/}
        is_run_dir "$day" && [[ ${name:0:10} < $cutoff ]] || continue
        rm -rf -- "$day"
        log "removed old results ${day##*/}"
    done
}

main() {
    local i global=OK
    while (( $# )); do
        case $1 in
            --config) CONFIG=${2:?--config needs a file}; shift 2 ;;
            --output) OUTPUT=${2:?--output needs a directory}; shift 2 ;;
            -h | --help) usage; exit 0 ;;
            *) usage >&2; exit 2 ;;
        esac
    done

    (( EUID != 0 )) || die "refusing to run as root, run it as the external-scan user"
    parse_config
    check_tools
    [[ $PDF_REPORT == off ]] || tool_versions

    mkdir -p "$OUTPUT" || die "cannot create $OUTPUT"
    exec 9>"$OUTPUT/.lock"
    flock -n 9 || die "another scan is already running"

    RUN_DIR=$OUTPUT/$RUN_ID
    # Only a second run in the same minute replaces the first one.
    [[ ! -d $RUN_DIR ]] || rm -rf -- "$RUN_DIR"
    mkdir -p "$RUN_DIR" || die "cannot create $RUN_DIR"
    LOG=$RUN_DIR/scan.log

    NMAP_ARGS=(-Pn -sV --script vulners -p- --open)
    if has_net_raw; then
        HAS_NET_RAW=1
        NMAP_ARGS+=(-sS --privileged)
        SCAN_TYPE="SYN scan"
    else
        NMAP_ARGS+=(-sT)
        SCAN_TYPE="TCP connect scan (no CAP_NET_RAW)"
    fi

    echo "external-scan: started, ${#TARGET_IPS[@]} target(s), results in $RUN_DIR"
    log "started, ${#TARGET_IPS[@]} target(s), $SCAN_TYPE"
    for i in "${!TARGET_IPS[@]}"; do
        scan_target "${TARGET_IPS[i]}" "${TARGET_LABELS[i]}"
    done

    (( ANY_ATTENTION )) && global=ATTENTION
    (( ANY_ERROR )) && global=ERROR
    {
        echo "External scan summary, $(run_time "$RUN_ID")"
        echo "Overall status: $global"
        echo
        printf '%s\n' "${SUMMARY[@]}"
    } >"$RUN_DIR/SUMMARY.txt"
    # Only now, so latest never points to a run without its summary.
    ln -sfnT "$RUN_ID" "$OUTPUT/latest" 2>>"$LOG" || log "cannot update $OUTPUT/latest"

    (( ANY_ERROR )) || prune_old

    log "finished, status $global"
    echo "external-scan: finished, status $global, see $RUN_DIR/SUMMARY.txt"
    (( ! ANY_ERROR ))
}

main "$@"
