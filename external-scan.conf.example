# external-scan configuration file
#
# Copy this file to external-scan.conf in the same directory. That copy holds
# your real targets and is ignored by git.
#
# LEGAL: only list IP addresses you have WRITTEN permission to scan. Ask the
# owner to whitelist the scanning machine in CrowdSec, their IDS, fail2ban or
# similar, or the scan gets blocked halfway.
#
# One setting per line, fields separated by spaces. "#" starts a comment.
# A line the script does not understand stops the scan with its line number.
#
# ---------------------------------------------------------------------------
# GLOBAL SETTINGS (optional, no indentation)
# ---------------------------------------------------------------------------
#
# cert_warn_days <days>     Flag a certificate that expires sooner. Default: 30
cert_warn_days 30
#
# keep_months <months>      Delete older results after each scan that ends
#                           without ERROR. Default: 12
keep_months 12
#
# udp_ports <port,...> | none
#   Replaces the list of UDP ports scanned on every target. All TCP ports are
#   always scanned. UDP uses a list because a full scan takes about 18 hours.
#   "none" turns UDP off. UDP needs CAP_NET_RAW, so it only runs from systemd.
#   Without this line the default list below is used.
#   Default: 7,17,19,53,67,69,88,111,123,137,138,161,162,389,427,443,464,
#   500,514,520,623,853,1194,1434,1701,1719,1812,1813,1900,2049,2427,3283,
#   3389,3478,3702,4500,4569,5060,5160,5349,5351,5353,5683,10001,11211,37810,
#   47808,51820,55820
#   NethServer 8: cluster WireGuard (55820), Samba AD (88, 464, 137, 138),
#   DHCP (67). Telephony: SIP (5060, 5160), IAX2 (4569), H.323 (1719), MGCP
#   (2427), STUN/TURN (3478, 5349). VPN: IPsec (500, 4500), OpenVPN (1194),
#   L2TP (1701), WireGuard (51820). Others: DNS, DNS over QUIC, TFTP, rpcbind,
#   NTP, SNMP and traps, CLDAP, QUIC, IPMI, MS-SQL browser, RADIUS, syslog,
#   RIP, NFS, SSDP, RDP, mDNS, NAT-PMP, Ubiquiti discovery, memcached, and
#   the amplification classics: echo, qotd, chargen, SLP, Apple Remote
#   Desktop, WS-Discovery, CoAP, DVR (37810), BACnet.
# udp_ports 53,123,161,500,4500,51820
#
# udp_ports_extra <port,...>
#   Adds ports to the udp_ports list, default or not, without copying it.
#   Several lines add up. With "udp_ports none", only these ports are scanned.
# udp_ports_extra 9987,27015
#
# sensitive_ports <port,...> | none
#   TCP ports risky to expose: remote access, admin pages, databases, file
#   sharing. Each one open is a finding ("sensitive/<port>") every month,
#   until it is closed or accepted.
#   Default: 21,23,135,139,445,902,1433,2082,2083,2086,2087,2222,2375,2376,
#   2379,2380,3306,3389,4848,5000,5001,5432,5601,5900,5901,5985,5986,6379,
#   6443,7001,8006,8007,8161,8291,8443,8728,8729,8834,8880,9000,9090,9200,
#   9443,9990,10000,10250,11211,15672,19999,20000,27017
#   Admin panels: cPanel and WHM (2082, 2083, 2086, 2087), DirectAdmin (2222),
#   Plesk (8443, 8880), Proxmox VE and PBS (8006, 8007), Cockpit (9090),
#   Portainer (9000, 9443), Webmin and Usermin (10000, 20000), Synology DSM
#   (5000, 5001), Netdata (19999), Kibana (5601), Nessus (8834), RabbitMQ
#   (15672), ActiveMQ (8161), Java servers (4848, 7001, 9990). Remote
#   management: ESXi (902), WinRM (5985, 5986), MikroTik (8291, 8728, 8729),
#   Kubernetes and etcd (2379, 2380, 6443, 10250).
# sensitive_ports 22,3389,9090
#
# web_scan on | off
#   Runs nuclei, a web vulnerability scanner, on every "https" line. It finds
#   outdated applications behind a reverse proxy, exposed admin pages, files
#   like .git or .env. Critical and high templates only, without dos,
#   intrusive and fuzz, at most 20 requests per second. Templates are
#   downloaded again at each scan. This is a vulnerability scan: turn it on
#   only when the written permission covers it. A target can override it.
#   Default: off
# web_scan on
#
# pdf_report on | off
#   Also writes REPORT_<name>_<date>_<time>.pdf per target, in English, for
#   the owner: who scanned, when, what and how, the findings, and the SHA-256
#   of every raw result. A failed PDF is noted in SUMMARY.txt and scan.log and
#   never changes the status. Default: off
# pdf_report on
#
# operator <text>           Who runs the scan, printed in the PDF.
# operator "Jane Doe, Example IT"
#
# ---------------------------------------------------------------------------
# TARGETS (one block per public IP address)
# ---------------------------------------------------------------------------
#
# target <ip> <label>
#   <ip>     ONE IPv4 address. IPv6, ranges and host names are refused. The
#            scan never connects to any other address for this block.
#   <label>  Free text. Used only in the report and the result folder name.
#
#   A "target" line alone already runs, on the bare IP:
#   - nmap on every TCP port and the udp_ports list, with service versions
#     and their known CVEs (vulners),
#   - testssl.sh on every open port nmap sees as SSL/TLS, and with STARTTLS
#     on every open SMTP, IMAP or POP3 port,
#   - ssh-audit on every port where nmap sees SSH.
#
# Indented lines under a target, all optional:
#
#   <mode> <fqdn> <port>
#   Tests a name with testssl.sh on the IP above. Needed for every site behind
#   a reverse proxy, which picks the certificate from the name: without it you
#   only see the default certificate. A port tested by name is not tested
#   again on the bare IP. An "https" line also gets nuclei when web_scan is on.
#   <mode>   https  TLS from the first byte, web site
#            smtps  TLS from the first byte, SMTP (465)
#            imaps  TLS from the first byte, IMAP (993)
#            pop3s  TLS from the first byte, POP3 (995)
#            tls    TLS from the first byte, any other protocol
#            smtp   STARTTLS, SMTP (25, 587)
#            imap   STARTTLS, IMAP (143)
#            pop3   STARTTLS, POP3 (110)
#   <fqdn>   Sent as SNI only. The connection always goes to <ip>. The report
#            says when the name resolves to another address.
#   <port>   A TCP port. Skipped, with a note, if nmap does not see it open.
#
#   web_scan on | off
#   Overrides the global web_scan for this target.
#
#   authorization <text>
#   The written permission for this address, printed in the PDF.
#
#   accept <key pattern> until <YYYY-MM-DD> <reason>
#   Accepts a known risk, so it stops raising the status. The report lists it
#   under "Accepted risks" with the reason, and it comes back after the date.
#   An accept line that matches nothing is noted in the report.
#   <key pattern>  A finding key as printed in the report, which also ends
#                  with ready-to-copy accept lines. "*" matches anything.
#                    tls/<name or ip>/<port>/<testssl id>   TLS finding
#                    cert/<name or ip>/<port>               certificate expiry
#                    ssh/<port>/<kex|key|enc|mac>/<alg>     weak SSH algorithm
#                    ssh/<port>/cve/<CVE id>                SSH CVE
#                    sshpw/<port>                           SSH accepts passwords
#                    sensitive/<port>                       sensitive port open
#                    dns/<name>                             name not on this IP
#                    web/<name>/<port>/<template id>        nuclei finding
#                    failed/tls/<name or ip>/<port>         testssl failed
#                    failed/ssh/<port>                      ssh-audit failed
#                    failed/sshpw/<port>                    SSH login check failed
#                    failed/web/<name>/<port>               nuclei failed
#                    failed/udp                             UDP scan failed
#   <YYYY-MM-DD>   Date to review the risk again. A year ahead at most.
#   <reason>       Why it is accepted, or what mitigates it.
#
# ---------------------------------------------------------------------------
# EXAMPLES (documentation addresses, remove the leading "# " to use)
# ---------------------------------------------------------------------------
#
# A firewall that forwards web and mail to a server behind it:
#
# target 203.0.113.10 firewall.example.com
#   authorization "purchase order 2026-042, signed by J. Smith on 2026-09-15"
#   web_scan on                   # the permission covers a vulnerability scan
#   https www.example.com   443
#   https cloud.example.com 443
#   smtp  mail.example.com  25
#   smtp  mail.example.com  587
#   smtps mail.example.com  465
#   imap  mail.example.com  143
#   imaps mail.example.com  993
#   pop3  mail.example.com  110
#   pop3s mail.example.com  995
#   accept sensitive/9090 until 2027-06-30 "firewall GUI, CrowdSec bans brute force, VPN planned"
#   accept tls/*/*/BREACH until 2027-06-30 "HTTP compression needed, no secret in responses"
#
# A second address with no name to test: the defaults are enough.
#
# target 198.51.100.20 home office
