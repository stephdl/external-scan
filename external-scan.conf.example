# external-scan configuration
#
# Copy this file to external-scan.conf, which git ignores.
#
# LEGAL: only list IP addresses you have WRITTEN permission to scan.
# Ask the owner to whitelist this machine in CrowdSec, the IDS, fail2ban...
# or the scan gets blocked halfway.
#
# One setting per line. "#" starts a comment. A wrong line stops the scan.

# ===========================================================================
# EXAMPLE (remove the "# " to use it)
# ===========================================================================
#
# Every target gets, with or without names:
#   - nmap on all TCP ports and the UDP list, with versions and known CVEs,
#   - testssl.sh on TLS, SMTP, IMAP and POP3 ports,
#   - ssh-audit and a password login check on SSH ports,
#   - a finding for each open sensitive port.
# Other ports, like plain HTTP on 80, are only listed.
#
# A name adds the real certificate behind a reverse proxy, a DNS check,
# and nuclei when web_scan is on.
#
# pdf_report on
# operator "Jane Doe, Example IT"
#
# # Firewall, web and mail by NAT. Vulnerability scan allowed.
# target 203.0.113.10 firewall.example.com
#   authorization "order 2026-042, signed by J. Smith"
#   web_scan on
#   https www.example.com   443
#   https cloud.example.com 443
#   smtp  mail.example.com  25
#   smtp  mail.example.com  587
#   tls   mail.example.com  465
#   imap  mail.example.com  143
#   tls   mail.example.com  993
#   accept sensitive/9090 until 2027-06-30 "firewall GUI, VPN planned"
#
# # Router, no name. Tested on the IP alone.
# target 198.51.100.20 office router
#   authorization "order 2026-042, signed by J. Smith"
#
# # Server, only the site named. Its other open ports are tested on the IP.
# target 192.0.2.30 cloud server
#   authorization "order 2026-042, signed by J. Smith"
#   https shop.example.com 443
#
# # LDAP and mail, no vulnerability scan. "tls" fits any TLS protocol.
# target 192.0.2.40 ldap and mail server
#   authorization "email from J. Smith, no vulnerability scan"
#   tls   ldap.example.com    636
#   https webmail.example.com 443
#   smtp  mx.example.com      25
#   accept tls/*/*/BREACH until 2027-06-30 "compression needed on the webmail"

# ===========================================================================
# GLOBAL SETTINGS (optional, not indented)
# ===========================================================================
#
# cert_warn_days <days>     Flag a certificate that expires sooner. Default 30.
cert_warn_days 30
# keep_months <months>      Delete older results after a scan without ERROR.
#                           Default 12.
keep_months 12
# pdf_report on|off         Also write a PDF report per target, for the owner.
#                           Default off.
# operator <text>           Who scans, printed in the PDF.
# web_scan on|off           Run nuclei on every "https" line: critical and high
#                           templates, 20 requests per second. It is a
#                           vulnerability scan, so only with written
#                           permission. A target can override it. Default off.
# udp_ports <list>|none     REPLACE the UDP port list. All TCP ports are always
#                           scanned. UDP needs systemd for the raw socket.
# udp_ports_extra <list>    ADD ports to the UDP list. Lines add up.
# sensitive_ports <list>|none
#                           REPLACE the list of TCP ports risky to expose. Each
#                           open one is a finding until closed or accepted.
#
# Lists are comma separated. The default lists are at the end of this file.

# ===========================================================================
# TARGETS (one block per IP)
# ===========================================================================
#
# target <ip> <label>
#   <ip> is one IPv4 address. Ranges, names and IPv6 are refused, and the
#   scan never connects anywhere else. <label> is free text, its first word
#   names the PDF.
#
# Indented lines, all optional:
#
#   <mode> <fqdn> <port>    Test this name on this port. The name is sent in
#                           SNI, the connection always goes to <ip>. Skipped
#                           with a note if the port is closed.
#     https                 web site, plus nuclei if web_scan is on
#     tls                   TLS from the first byte, any protocol: 465, 993,
#                           995, 636... smtps, imaps and pop3s are aliases.
#     smtp | imap | pop3    STARTTLS: 25 and 587, 143, 110
#
#   web_scan on|off         Override the global setting.
#   authorization <text>    The written permission, printed in the PDF.
#   accept <key> until <YYYY-MM-DD> <reason>
#                           Accept a known risk until that date. The report
#                           ends with ready to copy lines. "*" matches anything.
#
# Keys:
#   tls/<name|ip>/<port>/<testssl id>   TLS finding
#   cert/<name|ip>/<port>               certificate expires soon
#   ssh/<port>/<kex|key|enc|mac>/<alg>  weak SSH algorithm
#   ssh/<port>/cve/<CVE id>             SSH CVE
#   sshpw/<port>                        SSH accepts passwords
#   sensitive/<port>                    sensitive port open
#   dns/<name>                          name does not resolve to the IP
#   web/<name>/<port>/<template id>     nuclei finding
#   failed/tls/<name|ip>/<port>         testssl.sh failed
#   failed/ssh/<port>                   ssh-audit failed
#   failed/sshpw/<port>                 SSH login check failed
#   failed/web/<name>/<port>            nuclei failed
#   failed/udp                          UDP scan failed

# ===========================================================================
# DEFAULT PORT LISTS
# ===========================================================================
#
# udp_ports:
#   7,17,19,53,67,69,88,111,123,137,138,161,162,389,427,443,464,500,514,520,
#   623,853,1194,1434,1701,1719,1812,1813,1900,2049,2427,3283,3389,3478,3702,
#   4500,4569,5060,5160,5349,5351,5353,5683,10001,11211,37810,47808,51820,
#   55820
#   NethServer 8 (WireGuard 55820, Samba AD, DHCP), telephony (SIP, IAX2,
#   H.323, MGCP, STUN/TURN), VPN (IPsec, OpenVPN, L2TP, WireGuard), common
#   services (DNS, NTP, SNMP, LDAP, RADIUS, syslog, NFS, mDNS...) and ports
#   known for traffic amplification (echo, chargen, SSDP, memcached...).
#
# sensitive_ports:
#   21,23,135,139,445,902,1433,2082,2083,2086,2087,2222,2375,2376,2379,2380,
#   3306,3389,4848,5000,5001,5432,5601,5900,5901,5985,5986,6379,6443,7001,
#   8006,8007,8161,8291,8443,8728,8729,8834,8880,9000,9090,9200,9443,9990,
#   10000,10250,11211,15672,19999,20000,27017
#   Admin pages (cPanel, Plesk, Proxmox, Cockpit, Webmin, Portainer,
#   Synology...), remote access (Telnet, RDP, VNC, WinRM, MikroTik, ESXi),
#   file sharing (FTP, SMB), databases (MySQL, PostgreSQL, MS-SQL, Redis,
#   MongoDB, Elasticsearch), Docker and Kubernetes APIs.
